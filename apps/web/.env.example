# SplitFlow web — environment variables (example)
#
# Copy this file to apps/web/.env and fill in real values locally.
# Never commit an actual .env file.
#
# IMPORTANT: everything here is loaded into the BROWSER bundle by
# Vite (that's what the VITE_ prefix means). Only put PUBLIC values
# here — Supabase's anon key is designed to be public. Never put a
# Supabase service-role key, or any other backend-only secret, in a
# VITE_ variable. Backend-only secrets live in the root .env instead
# (see .env.example) and stay in apps/api. See AGENTS.md.

# Same Supabase project as the backend's SUPABASE_URL.
VITE_SUPABASE_URL=""

# Supabase's anon/public key — safe to expose to the browser by
# design (not the service-role key).
VITE_SUPABASE_ANON_KEY=""

# Base URL of the SplitFlow API. Defaults to http://localhost:4000
# if unset.
VITE_API_URL="http://localhost:4000"
