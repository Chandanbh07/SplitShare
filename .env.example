# SplitFlow — Environment Variables (example)
#
# Copy this file to .env and fill in real values locally.
# Never commit an actual .env file.
#
# IMPORTANT: Every credential in this file (Supabase service role key,
# storage keys, Gemini API key, and any future payment-provider keys)
# is BACKEND-ONLY. These belong exclusively to apps/api's environment
# and must never be sent to, bundled into, or made reachable from
# apps/web or any other client. Only non-secret, publishable values
# (e.g. a Supabase anon/public key intended for client use) may ever
# reach the frontend, and even those are configured separately from
# this backend .env file. See AGENTS.md.

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/splitflow?schema=public"

# ---------------------------------------------------------------------------
# Supabase Auth (planned)
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Storage — Supabase Storage or S3-compatible (planned)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="supabase" # or "s3"
STORAGE_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# ---------------------------------------------------------------------------
# AI — Gemini API (planned, suggestions/extraction only)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Realtime (Socket.IO)
# ---------------------------------------------------------------------------
SOCKET_IO_CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"

# ---------------------------------------------------------------------------
# UPI (not available in V1 — future scope)
# ---------------------------------------------------------------------------
# V1 settlement/payment recording is manual only. No UPI provider has
# been selected yet, so no variable names are declared here.
# Placeholder credentials were intentionally removed — adding UPI_*
# variables prematurely implies a provider decision that hasn't been
# made. Once a provider is chosen, its required variables will be
# added here (as backend-only secrets, per the banner above).
